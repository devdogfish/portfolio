# All server-only. Set these in Vercel (Production + Preview). Never prefix with NEXT_PUBLIC_.

# Quantself ingest (events + inquiries), devdogfish/quantself#301
QUANTSELF_INGEST_URL=http://127.0.0.1:3001
QUANTSELF_INGEST_TOKEN=

# Quantself tracked-links registry, devdogfish/quantself#302
TRACKED_LINKS_URL=http://127.0.0.1:3001/api/v1/tracked-links
TRACKED_LINKS_TOKEN=

# Daily-rotating visitor IP hash key, and comma-separated owner IPs to drop
ANALYTICS_IP_KEY=
ANALYTICS_EXCLUDED_IPS=

# Visit /?owner=<secret> once per device to stop tracking that browser
OWNER_TRACKING_SECRET=

# Booking API (server-to-server). Base URL and a token scoped to the meetings endpoints.
BOOKING_API_URL=
BOOKING_API_TOKEN=

# Cloudflare Turnstile for /book. Both are read at request time.
# For local development use Cloudflare's test keys, e.g. site key 1x00000000000000000000AA
# with secret 1x0000000000000000000000000000000AA (always passes).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
