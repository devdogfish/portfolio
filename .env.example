# Private Quantself relay; never use NEXT_PUBLIC_ for this token.
QUANTSELF_ANALYTICS_URL=http://127.0.0.1:4311/api/v1/website-analytics/events
QUANTSELF_ANALYTICS_TOKEN=
# Server-only key and comma-separated public IPs to exclude from analytics.
ANALYTICS_IP_KEY=
ANALYTICS_EXCLUDED_IPS=
# Optional: activate booking once Cal.com is configured.
BOOKING_URL=
